# これを .env に写して値を入れる (.env は git に入らない)。PC の環境変数に置いてもよい (その時は .env は要らない)
DISCORD_BOT_TOKEN=
# チャンネル id (Discord の設定 → 詳細設定 → 開発者モード ON → チャンネルを右クリック → ID をコピー)
WAKE_FEEDBACK_CHANNEL_ID=
WAKE_REPORT_CHANNEL_ID=

# ここから下は無くてよい (書いてあるのが既定)
# 分析君の結果を 1 行で知らせる先 (webhook の URL。無ければ state/results/ に残すだけ)
WAKE_NOTIFY_WEBHOOK=
# 1 日に起こす上限
WAKE_DAILY_MAX=10
# 起こさない時間 (JST、"1-7" = 1:00〜6:59。その間に来た物は明けてから)。空なら いつでも
WAKE_QUIET_HOURS=
# 1 本の上限 (分)
WAKE_TIMEOUT_MIN=20
# 1 にすると claude を起こさず、頼みの文を state/results/ に書くだけ (試し用)
WAKE_DRY_RUN=0
# 起こした claude に許す道具 (| で区切る)。既定は読むだけ
# WAKE_ALLOWED_TOOLS=Read|Grep|Glob|Bash(npx wrangler kv key list:*)|Bash(npx wrangler kv key get:*)|Bash(node scripts/pull-logs.mjs:*)|WebFetch(domain:exiledesk-live.exiledesk.workers.dev)
# WAKE_PERMISSION_MODE=default
# WAKE_REPO=C:\Users\kyohei\ExileDesk
# WAKE_CLAUDE_BIN=C:\Users\kyohei\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe

// 再現の確かめ用 (sim.ts、2026-10-10)。`npx wrangler dev --remote -c wrangler.sim.jsonc` で動かす。印は exiledesk_events_sim に書く (本物の exiledesk_events は読むだけ)。deploy しない
// Cloudflare Workers の設定 (exiledesk-live)。
// 5 分おきに channels.json のチャンネルがライブ中かを調べ、KV に 1 つの JSON で置く。
// サイトは GET /live.json を読むだけ (YouTube / Twitch には 5 分に 1 回しか問い合わせない)。
// ほかに: 相場の中継 (/api/poe2scout)・要望/バグ (/feedback)・操作の印 (/event → Analytics Engine)・分析用の記録 (/log → D1)・毎朝 9 時 (JST) の日報 (0 0 * * * UTC)・同じ時に昨日の記録を Discord へファイルで (secret の LOGS_WEBHOOK)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exiledesk-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": []
  },
  "kv_namespaces": [
    {
      "binding": "LIVE",
      // `wrangler kv namespace create LIVE` が出した id (2026-10-07、オーナーのアカウント)
      "id": "381d091adcaa439cb38d1fff106f7c63"
    }
  ],
  // 操作の印 (無料 10 万/日、3 か月残る)。日報は SQL API で集計する (CF_ANALYTICS_TOKEN が要る)
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "exiledesk_events_sim" }],
  // 分析用の記録 (POST /log、2026-10-09)。届いたまとまりを 1 行ずつ (無料 10 万行/日・5 GB)。取り出しは GET /logs/day?day=&key= か scripts/pull-logs.mjs
  "d1_databases": [{ "binding": "LOGS", "database_name": "exiledesk-logs", "database_id": "26272a12-1dfa-4d2f-aab4-cc27f7bc0efe", "migrations_dir": "migrations" }],
  "vars": {
    // 日報の集計 (GraphQL / SQL API) に使う。秘密ではない
    "CF_ACCOUNT_ID": "b824ebc2247db353f01cabcee65b567f",
    // Web Analytics のサイト (web.html の beacon の token)
    "WEB_ANALYTICS_SITE": "72192ac351aa4259ad607ec32e069cfb",
    // 数え始め (UTC)。これより前は日報と記録の取り出しで数えない (消してはいない)。2026-10-09 オーナーの PC の分を外すためにリセット
    "STATS_SINCE": "2026-10-09T11:15:51Z",
    // 再現の確かめの入口を開ける (sim.ts)
    "SIM": "1"
  },
  // 見本ページと枠の部品 (public/)。/ と /live-panel.js はここから、/live.json などは Worker から
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }
}

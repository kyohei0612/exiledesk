// スマホ用の開発版 (公開しない)。鍵付きの URL で開いた端末だけ見られる (dev-gate.js)。
// 置くのはリポジトリの根で `pnpm deploy:web-dev` (scripts/deploy-web-dev.mjs)。鍵は `wrangler secret put DEV_KEY -c wrangler.dev.jsonc`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-dev",
  "main": "dev-gate.js",
  "compatibility_date": "2026-09-01",
  // シェアの短い URL (/s/<id>) の中身。分析の記録と同じ D1 (KV は増やさない)。表は server/live/migrations/0007_shares.sql (2026-10-18)
  "d1_databases": [{ "binding": "LOGS", "database_name": "exiledesk-logs", "database_id": "26272a12-1dfa-4d2f-aab4-cc27f7bc0efe" }],
  "assets": {
    "directory": "../../dist-web-dev",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

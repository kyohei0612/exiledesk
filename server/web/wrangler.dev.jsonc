// スマホ用の開発版 (公開しない)。鍵付きの URL で開いた端末だけ見られる (dev-gate.js)。
// 置くのはリポジトリの根で `pnpm deploy:web-dev` (scripts/deploy-web-dev.mjs)。鍵は `wrangler secret put DEV_KEY -c wrangler.dev.jsonc`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-dev",
  "main": "dev-gate.js",
  "compatibility_date": "2026-09-01",
  // シェアの短い URL (/s/<id>) の中身。分析の記録と同じ D1 (KV は増やさない)。表は server/live/migrations/0007_shares.sql (2026-10-18)
  "d1_databases": [{ "binding": "LOGS", "database_name": "exiledesk-logs", "database_id": "26272a12-1dfa-4d2f-aab4-cc27f7bc0efe" }],
  "assets": {
    "directory": "../../dist-web-dev",
    "binding": "ASSETS",
    // 門 (dev-gate.js) を通すのはページと JS (/assets/) など。ゲームの絵・フォント・音は本番でも誰でも読める同じ物なので門を通さない
    // (2026-10-23: 全部を通していて、画面を開くたびに絵の 1 枚ずつが Worker のリクエストに数えられ、1 日 11.8 万回で無料の枠 10 万を超えた)
    "run_worker_first": ["/*", "!/skill-art/*", "!/base-art/*", "!/unique-art/*", "!/rune-art/*", "!/og-art/*", "!/ui-art/*", "!/fonts/*", "!/sfx/*", "!/favicon.ico", "!/favicon.png"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

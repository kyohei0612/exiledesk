// Web 版の置き場 (中身は静的ファイル。シェアの /s/*・/og/* だけ move-gate.js を通す、2026-10-25)。
// 中身は pnpm build:web が作る dist-web/。置くのはリポジトリの根で `pnpm deploy:web` (ビルド → ここで wrangler deploy)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  // シェアのカード (og-card.js) を返す。www の Bot 向けの 301 は Cloudflare の Redirect Rules (notes/2026-10-25-www-redirect-rule.md)
  "main": "move-gate.js",
  "compatibility_date": "2026-09-01",
  // シェアの短い URL (/s/<id>) の中身。分析の記録と同じ D1 (KV は増やさない)。表は server/live/migrations/0007_shares.sql (2026-10-18)
  "d1_databases": [{ "binding": "LOGS", "database_name": "exiledesk-logs", "database_id": "26272a12-1dfa-4d2f-aab4-cc27f7bc0efe" }],
  // 独自ドメイン (2026-10-11 Porkbun で取得、ネームサーバーは Cloudflare)。www も同じ所へ。web.exiledesk.workers.dev も残る
  // routes を書くと workers.dev が既定で切れる (2026-10-11 一度 404 になった)。今の URL (X のリンク) を生かすので必ず true
  "workers_dev": true,
  "routes": [
    { "pattern": "exiledesk.com", "custom_domain": true },
    { "pattern": "www.exiledesk.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../dist-web",
    "binding": "ASSETS",
    // Worker を通すのはシェアだけ。ページ・絵・JS・CSS は直接 (1 日 10 万の枠を食わない、越えても止まらない)。
    // 2026-10-25 トップを外した (巡回の Bot が web の Worker の 6〜8 割。docs/org/analytics/notes/2026-10-25-request-inventory.md)
    // /r/* はシミュのレシピの短い URL (recipe-share.js、表は 0011_recipe_shares.sql。2026-10-26)
    // /bases・/en/bases は消したベースのページ (Y-84、2026-10-31 オーナー「Aで」)。静的な置き場は 410 を返せないので Worker で返す (gone.js)
    // 続きの /blog/<slug>・/en/blog/<slug> は整理した記事 (2026-11-09、gone.js の BLOG_GONE・BLOG_MOVED と同じ 12 本。410・301、Y-84 の追記)。
    // 配列の中に一言を書かない (scripts/app-watch/static.mjs の Y-101 が JSON として読む)
    "run_worker_first": ["/s/*", "/og/*", "/r/*", "/bases", "/bases/*", "/en/bases", "/en/bases/*",
      "/blog/crafting-calculator-mistakes", "/blog/crafting-calculator-mistakes/*", "/en/blog/crafting-calculator-mistakes", "/en/blog/crafting-calculator-mistakes/*", "/blog/x-share-bug", "/blog/x-share-bug/*", "/en/blog/x-share-bug", "/en/blog/x-share-bug/*", "/blog/desecration-lords-tag-audit", "/blog/desecration-lords-tag-audit/*", "/en/blog/desecration-lords-tag-audit", "/en/blog/desecration-lords-tag-audit/*", "/blog/crafting-simulator-no-exceptions", "/blog/crafting-simulator-no-exceptions/*", "/en/blog/crafting-simulator-no-exceptions", "/en/blog/crafting-simulator-no-exceptions/*", "/blog/chaos-reroll-vs-restart", "/blog/chaos-reroll-vs-restart/*", "/en/blog/chaos-reroll-vs-restart", "/en/blog/chaos-reroll-vs-restart/*", "/blog/crafting-order-cost", "/blog/crafting-order-cost/*", "/en/blog/crafting-order-cost", "/en/blog/crafting-order-cost/*", "/blog/optimal-move-vs-intuition", "/blog/optimal-move-vs-intuition/*", "/en/blog/optimal-move-vs-intuition", "/en/blog/optimal-move-vs-intuition/*", "/blog/coe-desecrate-no-handler", "/blog/coe-desecrate-no-handler/*", "/en/blog/coe-desecrate-no-handler", "/en/blog/coe-desecrate-no-handler/*", "/blog/catalyst-types", "/blog/catalyst-types/*", "/en/blog/catalyst-types", "/en/blog/catalyst-types/*", "/blog/quality-rounding-down", "/blog/quality-rounding-down/*", "/en/blog/quality-rounding-down", "/en/blog/quality-rounding-down/*", "/blog/kolrs-hunt-gloves", "/blog/kolrs-hunt-gloves/*", "/en/blog/kolrs-hunt-gloves", "/en/blog/kolrs-hunt-gloves/*", "/blog/poe2db-cast-speed-weight", "/blog/poe2db-cast-speed-weight/*", "/en/blog/poe2db-cast-speed-weight", "/en/blog/poe2db-cast-speed-weight/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

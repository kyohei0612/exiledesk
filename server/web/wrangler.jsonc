// Web 版の置き場 (静的ファイルだけの Worker。無料、リクエスト数の上限なし)。
// 中身は pnpm build:web が作る dist-web/。置くのはリポジトリの根で `pnpm deploy:web` (ビルド → ここで wrangler deploy)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../dist-web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

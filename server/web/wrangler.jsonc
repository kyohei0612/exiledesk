// Web 版の置き場 (中身は静的ファイル。シェアの /s/*・/og/* だけ move-gate.js を通す、2026-10-25)。
// 中身は pnpm build:web が作る dist-web/。置くのはリポジトリの根で `pnpm deploy:web` (ビルド → ここで wrangler deploy)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  // シェアのカード (og-card.js) を返す。www の Bot 向けの 301 は Cloudflare の Redirect Rules (notes/2026-10-25-www-redirect-rule.md)
  "main": "move-gate.js",
  "compatibility_date": "2026-09-01",
  // シェアの短い URL (/s/<id>) の中身。分析の記録と同じ D1 (KV は増やさない)。表は server/live/migrations/0007_shares.sql (2026-10-18)
  "d1_databases": [{ "binding": "LOGS", "database_name": "exiledesk-logs", "database_id": "26272a12-1dfa-4d2f-aab4-cc27f7bc0efe" }],
  // 独自ドメイン (2026-10-11 Porkbun で取得、ネームサーバーは Cloudflare)。www も同じ所へ。web.exiledesk.workers.dev も残る
  // routes を書くと workers.dev が既定で切れる (2026-10-11 一度 404 になった)。今の URL (X のリンク) を生かすので必ず true
  "workers_dev": true,
  "routes": [
    { "pattern": "exiledesk.com", "custom_domain": true },
    { "pattern": "www.exiledesk.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../dist-web",
    "binding": "ASSETS",
    // Worker を通すのはシェアだけ。ページ・絵・JS・CSS は直接 (1 日 10 万の枠を食わない、越えても止まらない)。
    // 2026-10-25 トップを外した (巡回の Bot が web の Worker の 6〜8 割。docs/org/analytics/notes/2026-10-25-request-inventory.md)
    "run_worker_first": ["/s/*", "/og/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

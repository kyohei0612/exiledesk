{
  "$defs": {
    "Pick": {
      "additionalProperties": false,
      "description": "付ける MOD 1 つ。``mod`` は系統 (ColdResistance) か id (Rings/ColdResistance).",
      "properties": {
        "mod": {
          "minLength": 1,
          "title": "Mod",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "pattern": "^T\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "例 T6。無ければ乱数",
          "title": "Tier"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "数値。無ければ段の中の乱数",
          "title": "Values"
        }
      },
      "required": [
        "mod"
      ],
      "title": "Pick",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "description": "手順 1 つ。``times`` で同じカレンシーの連打を表す (Chaos ×5 など).",
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "omen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "お告げ id (price-keys.json の omens キー、例 OmenofDextralExaltation)",
          "title": "Omen"
        },
        "times": {
          "default": 1,
          "maximum": 200,
          "minimum": 1,
          "title": "Times",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "unique",
                "destroyed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可能性のオーブの結果を決め打ちする (動画で見せたい方)。無ければ乱数",
          "title": "Outcome"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "台本用の覚え書き (ExileDesk は無視してよい)",
          "title": "Note"
        },
        "pick": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pick"
            },
            {
              "items": {
                "$ref": "#/$defs/Pick"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "付く MOD の指名 (錬金などは配列、足りない分は乱数。⑱)",
          "title": "Pick"
        },
        "remove": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "カオス: 消える MOD の指名 (系統か id)",
          "title": "Remove"
        }
      },
      "required": [
        "currency"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "PobConfig": {
      "additionalProperties": false,
      "properties": {
        "resistancePenalty": {
          "default": -20,
          "description": "元素耐性のペナルティ (0 = アクト 1 … -60 = エンド)",
          "maximum": 0,
          "minimum": -60,
          "title": "Resistancepenalty",
          "type": "integer"
        },
        "enemyIsBoss": {
          "default": "None",
          "description": "普通の敵 / ボス",
          "enum": [
            "None",
            "Boss",
            "Pinnacle",
            "Uber"
          ],
          "title": "Enemyisboss",
          "type": "string"
        },
        "enemyLevel": {
          "anyOf": [
            {
              "maximum": 85,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "無ければキャラのレベル",
          "title": "Enemylevel"
        },
        "enemyArmour": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "敵のアーマー。無ければ PoB の表 (敵のレベルの目安)",
          "title": "Enemyarmour"
        }
      },
      "title": "PobConfig",
      "type": "object"
    },
    "PobSpec": {
      "additionalProperties": false,
      "description": "手順 JSON の pob。クラス・スキルは PoB の英語名 (Gems.lua の name).",
      "properties": {
        "class": {
          "description": "例 Monk / Ranger",
          "title": "Class",
          "type": "string"
        },
        "level": {
          "maximum": 100,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "skill": {
          "description": "例 Ice Strike",
          "title": "Skill",
          "type": "string"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        },
        "gem_level": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "無ければ使える一番高い物",
          "title": "Gem Level"
        },
        "skill_part": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "スキルの段 (番号か名前、例 Third Strike)。無ければ PoB の既定",
          "title": "Skill Part"
        },
        "quests_act": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "何アクトまでのクエスト報酬を入れるか。無ければ全部",
          "title": "Quests Act"
        },
        "config": {
          "$ref": "#/$defs/PobConfig"
        }
      },
      "required": [
        "class",
        "level",
        "skill"
      ],
      "title": "PobSpec",
      "type": "object"
    },
    "StartState": {
      "additionalProperties": false,
      "description": "手を見せずに最初から持っているアイテム (拾ったレア・作ったレア).",
      "properties": {
        "rarity": {
          "anyOf": [
            {
              "enum": [
                "normal",
                "magic",
                "rare"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "無ければ MOD 3 つ以上でレア",
          "title": "Rarity"
        },
        "mods": {
          "items": {
            "$ref": "#/$defs/Pick"
          },
          "maxItems": 6,
          "title": "Mods",
          "type": "array"
        },
        "quality": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "sockets": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sockets"
        }
      },
      "title": "StartState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "手順 JSON (POE2Tube → ExileDesk).",
  "properties": {
    "schema": {
      "default": "craft-stage-plan/1",
      "title": "Schema",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "動画の題材名 (表示用)",
      "title": "Title"
    },
    "base": {
      "description": "HTC の英語ベース名。ExileDesk 側は itemBaseFor(data, base) で引く",
      "title": "Base",
      "type": "string"
    },
    "item_level": {
      "default": 80,
      "maximum": 100,
      "minimum": 1,
      "title": "Item Level",
      "type": "integer"
    },
    "start_rarity": {
      "default": "normal",
      "enum": [
        "normal",
        "magic",
        "rare",
        "unique"
      ],
      "title": "Start Rarity",
      "type": "string"
    },
    "start_paste": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "途中から始める時のゲーム内アイテムテキスト (Ctrl+C 貼り付け)。無ければ白",
      "title": "Start Paste"
    },
    "seed": {
      "description": "mulberry32 の起点。1 手ごとの seed は ExileDesk が seed+index で派生させる",
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "start_unidentified": {
      "default": false,
      "description": "未鑑定から始める (鑑定の巻物の実演、マジック / レアの時)",
      "title": "Start Unidentified",
      "type": "boolean"
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/StartState"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "始めの状態 (手を見せずに持っているレア)。start_rarity より優先"
    },
    "tray": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "動画の棚に並べる物 (カレンシーキー / お告げ id の順)。無ければ手順から自動",
      "title": "Tray"
    },
    "pob": {
      "anyOf": [
        {
          "$ref": "#/$defs/PobSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "PoB でスキルの DPS を手ごとに計算する前提 (ExileDesk ⑰)"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "base",
    "seed",
    "steps"
  ],
  "title": "CraftStagePlan",
  "type": "object",
  "$id": "https://github.com/kyohei0612/POE2Tube/contracts/craft-stage-plan.schema.json"
}

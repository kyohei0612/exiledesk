{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExileDesk",
  "version": "0.1.30",
  "identifier": "com.kyohei.exiledesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ExileDesk",
        "width": 1280,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../src/i18n/*.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNTNDMTMwRDkyQTJFNDMKUldSRExpclpNTUZUN0xrUmltVE1VTTVFRHlQek01cjIwVnlibWs4RnZHVEI3MDZudytCNHJRUU4K",
      "endpoints": [
        "https://github.com/kyohei0612/exiledesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}

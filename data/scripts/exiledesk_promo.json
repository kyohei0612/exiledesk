        {
          "speaker": "zundamon",
          "emotion": "happy",
          "text": "クラフトに使う物は、ほとんど試せるのだ！",
          "scene": {
            "kind": "footage",
            "clip": "rune",
            "at": 8.5,
            "hold": 8.5,
            "mark": "card_rune"
          }
        }
      ]
    },
    {

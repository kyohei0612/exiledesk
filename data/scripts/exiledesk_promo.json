            "kind": "footage",
            "clip": "orbs",
            "at": 6
          }
        },
        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "王者のオーブでレアにするわね。",
          "scene": {
            "kind": "footage",
            "clip": "orbs",
            "at": 7
          }
        },
        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "〔結果: 王者〕",
          "scene": {
            "kind": "footage",
            "clip": "orbs",
            "at": 8
          }
        },
        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "続けて高貴なオーブを3回。",
          "scene": {
            "kind": "footage",
            "clip": "orbs",
            "at": 9
          }
        },
        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "〔結果: 高貴 1回目〕",
          "scene": {
            "kind": "footage",
            "clip": "orbs",
            "at": 10
          }
        },
        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "〔結果: 高貴 2回目〕",
          "scene": {
            "kind": "footage",
            "clip": "orbs",
            "at": 11
          }
        },
        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "〔結果: 高貴 3回目〕これで6つ埋まったわ。",

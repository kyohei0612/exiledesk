        {
          "speaker": "metan",
          "emotion": "normal",
          "text": "カレンシーを持つと、その下に、一緒に掛けられるお告げが出るの。",
          "scene": {
            "kind": "footage",
            "clip": "reveal",
            "at": 2.2,
            "hold": 3.8

{
  "$defs": {
    "PlanStep": {
      "additionalProperties": false,
      "description": "手順 1 つ。``times`` で同じカレンシーの連打を表す (Chaos ×5 など).",
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "omen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "お告げ id (price-keys.json の omens キー、例 OmenofDextralExaltation)",
          "title": "Omen"
        },
        "times": {
          "default": 1,
          "maximum": 200,
          "minimum": 1,
          "title": "Times",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "unique",
                "destroyed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可能性のオーブの結果を決め打ちする (動画で見せたい方)。無ければ乱数",
          "title": "Outcome"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "台本用の覚え書き (ExileDesk は無視してよい)",
          "title": "Note"
        }
      },
      "required": [
        "currency"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "PobConfig": {
      "additionalProperties": false,
      "properties": {
        "resistancePenalty": {
          "default": -20,
          "description": "元素耐性のペナルティ (0 = アクト 1 … -60 = エンド)",
          "maximum": 0,
          "minimum": -60,
          "title": "Resistancepenalty",
          "type": "integer"
        },
        "enemyIsBoss": {
          "default": "None",
          "description": "普通の敵 / ボス",
          "enum": [
            "None",
            "Boss",
            "Pinnacle",
            "Uber"
          ],
          "title": "Enemyisboss",
          "type": "string"
        },
        "enemyLevel": {
          "anyOf": [
            {
              "maximum": 85,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "無ければキャラのレベル",
          "title": "Enemylevel"
        }
      },
      "title": "PobConfig",
      "type": "object"
    },
    "PobSpec": {
      "additionalProperties": false,
      "description": "手順 JSON の pob。クラス・スキルは PoB の英語名 (Gems.lua の name).",
      "properties": {
        "class": {
          "description": "例 Monk / Ranger",
          "title": "Class",
          "type": "string"
        },
        "level": {
          "maximum": 100,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "skill": {
          "description": "例 Ice Strike",
          "title": "Skill",
          "type": "string"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        },
        "gem_level": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "無ければ使える一番高い物",
          "title": "Gem Level"
        },
        "config": {
          "$ref": "#/$defs/PobConfig"
        }
      },
      "required": [
        "class",
        "level",
        "skill"
      ],
      "title": "PobSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "手順 JSON (POE2Tube → ExileDesk).",
  "properties": {
    "schema": {
      "default": "craft-stage-plan/1",
      "title": "Schema",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "動画の題材名 (表示用)",
      "title": "Title"
    },
    "base": {
      "description": "HTC の英語ベース名。ExileDesk 側は itemBaseFor(data, base) で引く",
      "title": "Base",
      "type": "string"
    },
    "item_level": {
      "default": 80,
      "maximum": 100,
      "minimum": 1,
      "title": "Item Level",
      "type": "integer"
    },
    "start_rarity": {
      "default": "normal",
      "enum": [
        "normal",
        "magic",
        "rare",
        "unique"
      ],
      "title": "Start Rarity",
      "type": "string"
    },
    "start_paste": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "途中から始める時のゲーム内アイテムテキスト (Ctrl+C 貼り付け)。無ければ白",
      "title": "Start Paste"
    },
    "seed": {
      "description": "mulberry32 の起点。1 手ごとの seed は ExileDesk が seed+index で派生させる",
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "start_unidentified": {
      "default": false,
      "description": "未鑑定から始める (鑑定の巻物の実演、マジック / レアの時)",
      "title": "Start Unidentified",
      "type": "boolean"
    },
    "tray": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "動画の棚に並べる物 (カレンシーキー / お告げ id の順)。無ければ手順から自動",
      "title": "Tray"
    },
    "pob": {
      "anyOf": [
        {
          "$ref": "#/$defs/PobSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "PoB でスキルの DPS を手ごとに計算する前提 (ExileDesk ⑰)"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "base",
    "seed",
    "steps"
  ],
  "title": "CraftStagePlan",
  "type": "object",
  "$id": "https://github.com/kyohei0612/POE2Tube/contracts/craft-stage-plan.schema.json"
}
